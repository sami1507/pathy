<?xml version="1.0" encoding="utf-8"?>
<!-- Backups are disabled (android:allowBackup="false"). These rules also exclude everything,
     in case backup is re-enabled later: user data and keys must not leave the device. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
