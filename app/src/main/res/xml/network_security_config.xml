<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext (plain HTTP) is refused everywhere. Only the system trust store is used. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
